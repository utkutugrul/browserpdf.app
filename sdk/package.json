{
  "name": "@browserpdf/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Source-available browser ESM APIs for local PDF merge, inspection, diagnosis, and normalization.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test tests/sdk.node.test.mjs",
    "test": "npm run build && npm run check:dist && npm run typecheck && npm run test:unit"
  },
  "peerDependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
